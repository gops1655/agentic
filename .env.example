# ---- Claude (reads the invoice PDFs) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# ---- Mailbox that receives the invoices (IMAP) ----
# Gmail: imap.gmail.com / smtp.gmail.com, use an App Password (Google Account > Security > App passwords)
# Outlook/Office365: outlook.office365.com / smtp.office365.com (port 587, STARTTLS)
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# ---- Outgoing mail (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ssl (port 465) or starttls (port 587)
SMTP_SECURITY=ssl

# ---- Agent behaviour ----
# Minutes between inbox checks in watch mode
POLL_INTERVAL_MINUTES=5
# Only look at unread mails (true) or everything since SEARCH_SINCE_DAYS (false)
ONLY_UNREAD=true
SEARCH_SINCE_DAYS=7
# Optional comma-separated allow-list of senders or domains (e.g. vendor.com,billing@acme.in). Empty = everyone.
ALLOWED_SENDERS=
# Optional comma-separated subject keywords; mail must match one (e.g. invoice,bill). Empty = any subject.
SUBJECT_KEYWORDS=
# In watch mode, ask before sending each reply (true) or send automatically (false)
REQUIRE_APPROVAL=false
# Also send a copy of every reply to this address (optional)
CC_ADDRESS=
